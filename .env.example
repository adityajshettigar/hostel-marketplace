# ============================================================================
# hostel-marketplace — root environment template (Phase 1)
# Copy to .env and fill in values before docker compose up:
#   cp .env.example .env
# ============================================================================
# NOTE: NO VALUES here (per Phase 1 spec). Docker Compose loads this file via
# env_file on every service. Replace with your own dev values:
#   openssl rand - base64 64  for JWT_SECRET / RAZORPAY_WEBHOOK_SECRET etc.
# ============================================================================

# ─── Postgres (single shared instance, one schema per service) ──────────
# Superuser the postgres container provisions + runs the init scripts.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Least-privilege per-service DB role passwords (created by infra/init-db/002-roles.sh)
IDENTITY_DB_PASSWORD=
MARKETPLACE_DB_PASSWORD=
COMMUNICATION_DB_PASSWORD=
TRANSACTION_DB_PASSWORD=
AI_DB_PASSWORD=

# Connection URLs (schema-qualified) — services read these
IDENTITY_DATABASE_URL=
MARKETPLACE_DATABASE_URL=
COMMUNICATION_DATABASE_URL=
TRANSACTION_DATABASE_URL=
AI_DATABASE_URL=

# ─── Redis (single instance, cache + 48h escrow timer) ──────────────────
REDIS_URL=

# ─── Auth (identity-service issues JWT; all other services verify it) ──
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# ─── Internal service-to-service API key (not user-facing; e.g. communication-service POST /api/notifications) ──
INTERNAL_SERVICE_API_KEY=

# ─── Service URLs (Docker network hostnames; host = "localhost" locally) ─
GATEWAY_URL=http://localhost:4000
IDENTITY_SERVICE_URL=http://localhost:4001
MARKETPLACE_SERVICE_URL=http://localhost:4002
COMMUNICATION_SERVICE_URL=http://localhost:4003
TRANSACTION_SERVICE_URL=http://localhost:4004
AI_SERVICE_URL=http://localhost:4005


# ─── Phase 7 gateway: downstream URLs (compose service names) + shared secret ──
SERVICE_IDENTITY_URL=http://identity-service:4001
SERVICE_MARKETPLACE_URL=http://marketplace-service:4002
SERVICE_COMMUNICATION_URL=http://communication-service:4003
SERVICE_TRANSACTION_URL=http://transaction-service:4004
SERVICE_AI_URL=http://ai-service:4005
INTERNAL_SERVICE_KEY=
# Deploy-time admin allowlist (comma-separated user UUIDs; audit Q4).
# LEGACY: roles now live in the identity users.role column (admin console
# "userbase" page). This list is only a fallback for transaction-service.
ADMIN_USER_IDS=

# ─── Frontend ───────────────────────────────────────────────────────────
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000
# Browser origin allowed through CORS (Phase 9). Defaults to the value above
# when unset, so it is optional; set it explicitly for a custom frontend host.
FRONTEND_ORIGIN=http://localhost:3000

# ─── Payments (Razorpay TEST MODE only — real money never leaves this env) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Payout destination for RazorpayX fund-account transfers (handover → payout).
# Leave empty to keep payouts retriable-unconfigured (handover verify still succeeds).
RAZORPAY_FUND_ACCOUNT_ID=

# Comma-separated college email domains allowed at signup (identity-service,
# zod .min(1) — signup 500s if unset).
COLLEGE_EMAIL_DOMAINS=

# ─── File storage (Cloudinary free tier — product images, dispute evidence) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ─── AI (ai-service: rule/heuristic-first; HF optional) ────────────────
HUGGINGFACE_API_KEY=

# ─── AI-service Phase 5 (free Hugging Face Inference API captioning) ──
# Leave HF_API_TOKEN empty to run in pure-template fallback mode.
HF_API_TOKEN=

# Handover QR encryption key (transaction-service, AES-256-GCM).
# MUST be base64 decoding to exactly 32 bytes; generate locally with:
#   openssl rand -base64 32
# Leave empty and QR encryption at handover will fail (webhook 500s on the
# QR step). There is no fallback key.
QR_ENCRYPTION_KEY=
HF_CAPTION_MODEL=Salesforce/blip-image-captioning-base
HF_API_URL=https://api-inference.huggingface.co/models
